{
  "version": "uvp.constraints.v1",
  "title": "UVP 跨语言验证约束注册表",
  "description": "簇I 跨轨接受面约束的单一出处。三线 validator（Rust: uvp-core crates/uvp-compiler + uvp-hook-dsl；Go: pkg/compiler/validator + pkg/compiler；TS: uvp-protocol packages/compiler）共用的长度/枚举/字符集/取值域规则在此登记；params 一律从各线代码实测抄录。三线一致性 harness（uvp-protocol packages/compiler/test、uvp-core crates/uvp-compiler/tests、Go pkg/compiler/validator）钉住本文件的 version 与 sha256 并逐 rule 生成边界探针打真 validator：任何一处改表，三线测试同声报警。",
  "constraintTypes": ["max_length", "min_length", "pattern", "closed_enum", "integer_range", "forbidden", "required"],
  "notes": [
    "error.<line> 存真实错误码/错误名/错误消息锚点（harness 断言用子串匹配）；line 未实现时为 null 且不出现在 applies。",
    "lineParams 只在某线实测参数与 ruling 参数不一致时登记（不对称登记，漂移现场存档）；缺省表示该线与 constraint.params 一致。",
    "go 线的 hook DSL 约束经 pkg/hookdsl → uvp-core FFI 继承（uvpcore.ParseHook），Go 本地另有防御纵深校验，两者都登记在 error.go / notes。"
  ],
  "rules": [
    {
      "id": "zhixu-api-version-closed-enum",
      "area": "zhixu",
      "target": "apiVersion",
      "constraint": { "type": "closed_enum", "params": { "values": ["uvp/v0"] } },
      "error": {
        "rust": "apiVersion must be uvp/v0",
        "go": "unsupport type",
        "ts": "apiVersion must be uvp/v0"
      },
      "applies": ["rust", "go", "ts"],
      "sources": {
        "rust": "crates/uvp-compiler/src/lib.rs validate_zhixu_shape",
        "go": "pkg/compiler/compiler.go Validate -> registry dispatch（uvp/v0/Zhixu 注册键，未命中报 unsupport type）",
        "ts": "packages/compiler/src/zhixu-loader.ts assertZhixuDefinitionShape"
      },
      "ruling": "簇I 裁决：apiVersion 闭集 {uvp/v0}，大小写敏感，三线同口径拒绝。"
    },
    {
      "id": "zhixu-kind-closed-enum",
      "area": "zhixu",
      "target": "kind",
      "constraint": { "type": "closed_enum", "params": { "values": ["Zhixu"] } },
      "error": {
        "rust": "kind must be Zhixu",
        "go": "unsupport type",
        "ts": "kind must be Zhixu"
      },
      "applies": ["rust", "go", "ts"],
      "sources": {
        "rust": "crates/uvp-compiler/src/lib.rs validate_zhixu_shape",
        "go": "pkg/compiler/compiler.go Validate -> registry dispatch",
        "ts": "packages/compiler/src/zhixu-loader.ts assertZhixuDefinitionShape"
      },
      "ruling": "簇I 裁决：kind 闭集 {Zhixu}。"
    },
    {
      "id": "metadata-name-required",
      "area": "zhixu",
      "target": "metadata.name",
      "constraint": { "type": "required", "params": { "trim": true } },
      "error": {
        "rust": "metadata.name must be non-empty",
        "go": "metadata.name is required and cannot be blank",
        "ts": "metadata.name is required"
      },
      "applies": ["rust", "go", "ts"],
      "sources": {
        "rust": "crates/uvp-compiler/src/lib.rs validate_zhixu_shape",
        "go": "pkg/compiler/validator/zhixu_schema.go validateDDLDimensions",
        "ts": "packages/compiler/src/zhixu-loader.ts assertZhixuDefinitionShape"
      },
      "ruling": "簇I 裁决：metadata.name 必填非空（rust/go trim 后非空；ts 要求 string）。"
    },
    {
      "id": "metadata-name-max-length",
      "area": "zhixu",
      "target": "metadata.name",
      "constraint": { "type": "max_length", "params": { "max": 100, "unit": "bytes" } },
      "error": {
        "rust": "exceeds 100 bytes (global_zhixu.name)",
        "go": "exceeds 100 bytes (global_zhixu.name)",
        "ts": null
      },
      "applies": ["rust", "go"],
      "sources": {
        "rust": "crates/uvp-compiler/src/lib.rs MAX_IDENTIFIER_BYTES",
        "go": "pkg/compiler/validator/zhixu_schema.go validateDDLDimensions"
      },
      "ruling": "簇I 裁决：≤100 字节（global_zhixu.name VARCHAR(100) DDL 镜像）。"
    },
    {
      "id": "metadata-uid-max-length",
      "area": "zhixu",
      "target": "metadata.uid",
      "constraint": { "type": "max_length", "params": { "max": 64, "unit": "bytes" } },
      "error": {
        "rust": "exceeds 64 bytes (global_zhixu.uid)",
        "go": "exceeds 64 bytes (global_zhixu.uid)",
        "ts": null
      },
      "applies": ["rust", "go"],
      "sources": {
        "rust": "crates/uvp-compiler/src/lib.rs MAX_UID_BYTES",
        "go": "pkg/compiler/validator/zhixu_schema.go validateDDLDimensions"
      },
      "ruling": "簇I 裁决：uid ≤64 字节（global_zhixu.uid VARCHAR(64)）。rust/go 均对 trim 后判长、空串放行（uid 可缺省）。"
    },
    {
      "id": "stage-identifier-max-length",
      "area": "zhixu",
      "target": "taskPatterns[].stages[] 组合标识 {taskName}.{stageName}",
      "constraint": { "type": "max_length", "params": { "max": 100, "unit": "bytes" } },
      "error": {
        "rust": "exceeds 100 bytes (global_stage.stage_identifier)",
        "go": "exceeds 100 bytes (global_stage.stage_identifier)",
        "ts": null
      },
      "applies": ["rust", "go"],
      "sources": {
        "rust": "crates/uvp-compiler/src/lib.rs MAX_IDENTIFIER_BYTES",
        "go": "pkg/compiler/validator/zhixu_schema.go validateDDLDimensions"
      },
      "ruling": "簇I 裁决：stage identifier ≤100 字节（global_stage.stage_identifier VARCHAR(100)）。"
    },
    {
      "id": "stage-source-max-length",
      "area": "zhixu",
      "target": "taskPatterns[].stages[].source",
      "constraint": { "type": "max_length", "params": { "max": 36, "unit": "bytes" } },
      "lineParams": {
        "go": { "max": 100, "note": "Go validateDDLDimensions 实测按 global_stage.source VARCHAR(100) 判 100；rust 按『source 兼任路由键与 sourceId=keccak(source) 哈希输入，订阅路由维度列宽 36』判 36。簇I 裁决 36，go 侧差异在此存档，探针按各线实测值断言。" }
      },
      "error": {
        "rust": "exceeds 36 bytes",
        "go": "exceeds 100 bytes (global_stage.source)",
        "ts": null
      },
      "applies": ["rust", "go"],
      "sources": {
        "rust": "crates/uvp-compiler/src/lib.rs MAX_STAGE_SOURCE_BYTES",
        "go": "pkg/compiler/validator/zhixu_schema.go validateDDLDimensions"
      },
      "ruling": "簇I 裁决：stage.source ≤36（与订阅 target source 同值）；go 线当前实现 100，属已登记漂移，解冻时应对齐。"
    },
    {
      "id": "stage-source-required",
      "area": "zhixu",
      "target": "taskPatterns[].stages[].source",
      "constraint": { "type": "required", "params": { "trim": true } },
      "error": {
        "rust": "source must be non-empty",
        "go": null,
        "ts": null
      },
      "applies": ["rust"],
      "sources": {
        "rust": "crates/uvp-compiler/src/lib.rs validate_zhixu_shape（空串会以空键混进 mintedSources）"
      },
      "ruling": "单线登记：rust 强制 stage.source 非空；go/ts 无此校验（不对称现状）。"
    },
    {
      "id": "stage-source-charset",
      "area": "zhixu",
      "target": "taskPatterns[].stages[].source",
      "constraint": { "type": "pattern", "params": { "regex": "^[A-Za-z0-9_-]+$", "charset": "ASCII letters, digits, '_' or '-'" } },
      "error": {
        "rust": "must be a plain identifier (ASCII letters, digits, '_' or '-')",
        "go": null,
        "ts": null
      },
      "applies": ["rust"],
      "sources": {
        "rust": "crates/uvp-compiler/src/lib.rs is_plain_source_identifier"
      },
      "ruling": "单线登记：rust 强制 stage.source 为 plain identifier；go/ts 无此校验（不对称现状）。"
    },
    {
      "id": "send-signal-combined-max-length",
      "area": "zhixu",
      "target": "stageIdentifier + \".\" + sendSignal 组合信号名",
      "constraint": { "type": "max_length", "params": { "max": 100, "unit": "bytes", "formula": "len(stageIdentifier) + 1 + len(signal)" } },
      "error": {
        "rust": "exceeds 100 bytes combined (individual_record.signal_name)",
        "go": "exceeds 100 bytes combined (individual_record.signal_name)",
        "ts": null
      },
      "applies": ["rust", "go"],
      "sources": {
        "rust": "crates/uvp-compiler/src/lib.rs MAX_SIGNAL_NAME_BYTES",
        "go": "pkg/compiler/validator/zhixu_schema.go validateDDLDimensions（maxSignalNameBytes=100）"
      },
      "ruling": "簇I 裁决：执行器自发信号拼 task.stage.signal 落 individual_record.signal_name VARCHAR(100)，组合 ≤100；stage 标识符合法不等于组合合法。"
    },
    {
      "id": "receive-signals-key-max-length",
      "area": "hook-dsl",
      "target": "receiveSignals 键（= hook_name，落 global_hook.hook_name）",
      "constraint": { "type": "max_length", "params": { "max": 36, "unit": "bytes" } },
      "error": {
        "rust": "hook_name must be 1-36 characters",
        "go": "hook_name must be 1-36 characters（go 线可达路径是 uvp-core FFI 文案；Go 本地文案 exceeds 36 bytes (global_hook.hook_name) 因 validateTaskPatterns 先行返回而不可达）",
        "ts": null
      },
      "applies": ["rust", "go"],
      "sources": {
        "rust": "crates/uvp-hook-dsl/src/lib.rs parse（hook_name 1..=36）",
        "go": "pkg/compiler/validator/zhixu_schema.go validateDDLDimensions"
      },
      "ruling": "簇I 裁决：receiveSignals 键 ≤36 字节。rust 在 parse 期以 hook_name 名义拒绝；go 在 schema validator 以 DDL 名义拒绝（CompileHook 经 FFI 亦会拒）。"
    },
    {
      "id": "hook-source-class-max-length",
      "area": "hook-dsl",
      "target": "hook 标头 source 类 `{source}::condition`",
      "constraint": { "type": "max_length", "params": { "max": 36, "unit": "bytes" } },
      "error": {
        "rust": "hook source class exceeds the maximum length of 36",
        "go": "hook source class exceeds the maximum length of 36（go 线可达路径是 uvp-core FFI 文案；Go 本地纵深文案 source class exceeds 36 bytes 被 FFI 先行拒绝，实测不可达）",
        "ts": null
      },
      "applies": ["rust", "go"],
      "sources": {
        "rust": "crates/uvp-hook-dsl/src/lib.rs parse（标头 source ≤36）",
        "go": "pkg/compiler/validator/zhixu_schema.go validateStage（defense-in-depth）；实际先由 uvp-core FFI parse 拒绝，锚点两文案任一命中均可"
      },
      "ruling": "簇I 裁决：hook 标头 source 类 ≤36 字节（hook_dependency.source_zhixu_id VARCHAR(36)）。"
    },
    {
      "id": "hook-source-class-charset",
      "area": "hook-dsl",
      "target": "hook 标头 source 类",
      "constraint": { "type": "pattern", "params": { "regex": "^[A-Za-z0-9_-]+$", "charset": "plain identifier" } },
      "error": {
        "rust": "hook source must be a plain identifier",
        "go": null,
        "ts": null
      },
      "applies": ["rust"],
      "sources": {
        "rust": "crates/uvp-hook-dsl/src/lib.rs parse（is_plain_identifier）"
      },
      "ruling": "单线登记：rust 在 parse 期拒绝空格/Unicode/额外分隔符；go/ts 无独立校验（go 经 FFI 继承，但无本线错误文案）。"
    },
    {
      "id": "subscription-target-source-max-length",
      "area": "hook-dsl",
      "target": "订阅目标 `::ANCHOR(@source::task.stage.signal)` 的 @source",
      "constraint": { "type": "max_length", "params": { "max": 36, "unit": "bytes" } },
      "error": {
        "rust": "subscription source exceeds the maximum length of 36",
        "go": "subscription source exceeds the maximum length of 36（go 线可达路径是 uvp-core FFI 文案；Go 本地纵深文案 subscription source class exceeds 36 bytes 被 FFI 先行拒绝，实测不可达）",
        "ts": null
      },
      "applies": ["rust", "go"],
      "sources": {
        "rust": "crates/uvp-hook-dsl/src/lib.rs parse_subscription",
        "go": "pkg/compiler/validator/zhixu_schema.go validateStage（defense-in-depth）；实测先由 uvp-core FFI 拒绝"
      },
      "ruling": "簇I 裁决：订阅 source 类 ≤36 字节（hook_dependency.source_zhixu_id VARCHAR(36)），与标头 source 同值。"
    },
    {
      "id": "subscription-target-signal-max-length",
      "area": "hook-dsl",
      "target": "订阅目标 signal 全名",
      "constraint": { "type": "max_length", "params": { "max": 100, "unit": "bytes" } },
      "error": {
        "rust": "subscription target signal exceeds the maximum length of 100",
        "go": "subscription target signal exceeds the maximum length of 100（go 线可达路径是 uvp-core FFI 文案；Go 本地文案 exceeds 100 bytes (hook_dependency.signal_name) 被 FFI 先行拒绝，实测不可达）",
        "ts": null
      },
      "applies": ["rust", "go"],
      "sources": {
        "rust": "crates/uvp-hook-dsl/src/lib.rs parse_subscription",
        "go": "pkg/compiler/validator/zhixu_schema.go validateStage（SubscriptionTarget.SignalName / dependencies，maxSignalNameBytes=100）"
      },
      "ruling": "簇I 裁决：订阅目标信号名 ≤100 字节（signal_name VARCHAR(100)）。"
    },
    {
      "id": "hook-delay-seconds-range",
      "area": "hook-dsl",
      "target": "delay 操作的 durationSeconds（DSL `+<duration>` / on-chain instruction delaySeconds）",
      "constraint": { "type": "integer_range", "params": { "min": 1, "max": 2592000, "maxHuman": "30d（30*24*60*60）" } },
      "error": {
        "rust": "exceeds the maximum allowed delay of 2592000s；零延时文案 invalid duration",
        "go": "exceeds the maximum allowed delay of 2592000s（经 uvp-core FFI；本地常量 pkg/hookdsl MaxDelaySeconds 同值）；零延时文案 invalid duration",
        "ts": "delaySeconds must be a positive safe integer；上限文案 must not exceed 2592000 (contract MAX_HOOK_DELAY_SECONDS = 30 days, reverts HookDelayTooLong)"
      },
      "applies": ["rust", "go", "ts"],
      "sources": {
        "rust": "crates/uvp-hook-dsl/src/lib.rs MAX_DELAY_SECONDS = 30*24*60*60",
        "go": "pkg/hookdsl/hookdsl.go MaxDelaySeconds = 30*24*60*60（判定在 uvp-core FFI）",
        "ts": "packages/compiler/src/onchain-hook-plan.ts MAX_ONCHAIN_HOOK_DELAY_SECONDS = 2_592_000（镜像 UVPStateMachine.MAX_HOOK_DELAY_SECONDS，reverts HookDelayTooLong）"
      },
      "ruling": "簇I 裁决：延时为正整数、上限 30 天=2592000 秒；三线同值，链上以 HookDelayTooLong 回滚为准。"
    },
    {
      "id": "onchain-instruction-op-closed-enum",
      "area": "onchain-plan",
      "target": "on-chain HookPlan compiledHooks[].instructions[].op",
      "constraint": { "type": "closed_enum", "params": { "values": ["SIGNAL", "NOT", "AND", "OR", "DELAY"] } },
      "error": {
        "rust": null,
        "go": null,
        "ts": "op must be one of SIGNAL, NOT, AND, OR, DELAY"
      },
      "applies": ["ts"],
      "sources": {
        "ts": "packages/compiler/src/onchain-hook-plan.ts validateOnchainCompiledHooks（对齐 UVPStateMachine._validateHook 的合法 op 集）"
      },
      "ruling": "单线登记：op 闭集当前只有 TS artifact 边界与 Solidity 契约（uint8 op + _validateHook）持有；rust/go 不校验该层。"
    },
    {
      "id": "plan-dependencies-max-count",
      "area": "onchain-plan",
      "target": "整计划去重后的 dependency key 总数",
      "constraint": { "type": "integer_range", "params": { "min": 1, "max": 1024 } },
      "error": {
        "rust": null,
        "go": null,
        "ts": "exceed the contract limit 1024 (commitPlan reverts TooManyDependencies)"
      },
      "applies": ["ts"],
      "sources": {
        "ts": "packages/compiler/src/onchain-hook-plan.ts MAX_PLAN_DEPENDENCIES = 1024（镜像 UVPStateMachine.MAX_PLAN_DEPENDENCIES，reverts TooManyDependencies）"
      },
      "ruling": "单线登记：MAX_PLAN_DEPENDENCIES=1024 权威在 Solidity 契约 UVPStateMachine，TS preflight 同口径预检；rust/go 编译线无此上限。"
    },
    {
      "id": "dock-schema-version-closed-enum",
      "area": "dock",
      "target": "executor.zhixuExecutorConfig.schemaVersion",
      "constraint": { "type": "closed_enum", "params": { "values": ["uvp.dock.v1"] } },
      "error": {
        "rust": "D002",
        "go": "zhixuExecutorConfig.schemaVersion must be \"uvp.dock.v1\"",
        "ts": null
      },
      "applies": ["rust", "go"],
      "sources": {
        "rust": "crates/uvp-compiler/src/dock.rs parse_zhixu_executor_config（DOCK_SCHEMA_VERSION，错误码 D002）",
        "go": "pkg/compiler/validator/zhixu_schema.go validateExecutor（D002）"
      },
      "ruling": "簇I 裁决：dock 委托配置 schemaVersion 闭集 {uvp.dock.v1}，错误码 D002。"
    },
    {
      "id": "dock-order-id-policy-closed-enum",
      "area": "dock",
      "target": "executor.zhixuExecutorConfig.order.idPolicy",
      "constraint": { "type": "closed_enum", "params": { "values": ["derived-v1"] } },
      "error": {
        "rust": "D004",
        "go": "zhixuExecutorConfig.order.idPolicy must be \"derived-v1\"",
        "ts": null
      },
      "applies": ["rust", "go"],
      "sources": {
        "rust": "crates/uvp-compiler/src/dock.rs parse_zhixu_executor_config（D004）",
        "go": "pkg/compiler/validator/zhixu_schema.go validateExecutor（D004）"
      },
      "ruling": "簇I 裁决：订单 ID 策略闭集 {derived-v1}（order.idPolicy=derived-v1，字符串 orderID 先 keccak 派生），错误码 D004。"
    },
    {
      "id": "dock-target-uid-required",
      "area": "dock",
      "target": "executor.zhixuExecutorConfig.target.zhixu",
      "constraint": { "type": "required_non_empty", "params": { "note": "uid（不可变 catalog UID）即完整定义身份；target 只携带 zhixu，残留 version 等键按未知字段确定性拒绝" } },
      "error": {
        "rust": "D003",
        "go": "zhixuExecutorConfig.target.zhixu is required",
        "ts": null
      },
      "applies": ["rust", "go"],
      "sources": {
        "rust": "crates/uvp-compiler/src/dock.rs parse_zhixu_executor_config（D003，target 只接受 zhixu 键）",
        "go": "pkg/compiler/validator/zhixu_schema.go validateExecutor（D003；target.version 字段已随 PRD_101 删除，strict decode 拒绝残留键）"
      },
      "ruling": "PRD_101 裁决：dock 目标引用只剩 zhixu——uid 即完整定义身份，version 维度删除。"
    },
    {
      "id": "dock-port-name-pattern",
      "area": "dock",
      "target": "zhixuExecutorConfig.inputMap/signalMap 的 value（目标端口名）",
      "constraint": { "type": "pattern", "params": { "regex": "^[a-z][a-z0-9_]{0,31}$", "maxBytes": 32 } },
      "error": {
        "rust": "D005/D006 value must be a port name matching ^[a-z][a-z0-9_]{0,31}$",
        "go": "must match ^[a-z][a-z0-9_]{0,31}$",
        "ts": null
      },
      "applies": ["rust", "go"],
      "sources": {
        "rust": "crates/uvp-compiler/src/dock.rs valid_port_name / MAX_PORT_NAME_BYTES（D005/D006 引用）",
        "go": "pkg/compiler/validator/zhixu_schema.go validateDockPortName"
      },
      "ruling": "簇I 裁决：端口名 ^[a-z][a-z0-9_]{0,31}$（PRD94 §3.2），≤32 字节。"
    },
    {
      "id": "dock-signalmap-key-max-length",
      "area": "dock",
      "target": "executor.zhixuExecutorConfig.signalMap 键",
      "constraint": { "type": "max_length", "params": { "max": 26, "unit": "bytes" } },
      "error": {
        "rust": "D006",
        "go": "must be at most 26 bytes",
        "ts": null
      },
      "applies": ["rust", "go"],
      "sources": {
        "rust": "crates/uvp-compiler/src/dock.rs MAX_SIGNAL_MAP_KEY_LENGTH（错误码 D006）",
        "go": "pkg/compiler/validator/zhixu_schema.go validateExecutor"
      },
      "ruling": "簇I 裁决：signalMap 键 ≤26 字节（运行期 hook_name = \"signalMap.\" + key 共 36 字节列宽，10 字节前缀）。"
    },
    {
      "id": "dock-signalmap-key-forbidden-separator",
      "area": "dock",
      "target": "executor.zhixuExecutorConfig.signalMap 键",
      "constraint": { "type": "forbidden", "params": { "substrings": ["."], "reason": "'.' 是 canonical 信号名 task.stage.signal 的分隔符，键是运行期 hook 命名空间" } },
      "error": {
        "rust": "D006",
        "go": "must not contain '.'",
        "ts": null
      },
      "applies": ["rust", "go"],
